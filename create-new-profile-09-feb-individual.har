            "size": 62101,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n\n<html lang=\"en\"\n  class=\"layout-navbar-fixed layout-compact layout-menu-fixed   \"\n  dir=\"ltr\" data-skin=\"default\" data-assets-path=\"https://atap.seda.gov.my/assets/\"\n  data-base-url=\"http://atap.seda.gov.my\" data-framework=\"laravel\" data-template=\"vertical-menu-template\"\n  data-bs-theme=\"light\" >\n\n<head>\n    <!-- Google tag (gtag.js) -->\n  <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-E2LK0KED13\"></script>\n  <script>\n    window.dataLayer = window.dataLayer || [];\n    function gtag(){dataLayer.push(arguments);}\n    gtag('js', new Date());\n  \n    gtag('config', 'G-E2LK0KED13');\n  </script>\n    <meta charset=\"utf-8\" />\n  <meta name=\"viewport\"\n    content=\"width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0\" />\n\n  <title>\n    Profile - Edit Company | eATAP\n    - SEDA Malaysia\n  </title>\n  <meta name=\"description\"\n    content=\"eATAP - Solar Accelerated Transition Action Programme by SEDA Malaysia\" />\n  <meta name=\"keywords\"\n    content=\"renewable energy, seda malaysia, solar pv, atap, accelerated transition action programme\" />\n  <meta property=\"og:title\" content=\"Materio Bootstrap 5 HTML + Laravel Admin Template by ThemeSelection\" />\n  <meta property=\"og:type\" content=\"product\" />\n  <meta property=\"og:url\" content=\"https://themeselection.com/item/materio-dashboard-pro-laravel/\" />\n  <meta property=\"og:image\" content=\"https://ts-assets.b-cdn.net/ts-assets/materio/materio-bootstrap-laravel-admin-template/marketing/materio-bootstrap-laravel-admin-template-smm.png\" />\n  <meta property=\"og:description\"\n    content=\"eATAP - Solar Accelerated Transition Action Programme by SEDA Malaysia\" />\n  <meta property=\"og:site_name\"\n    content=\"SEDA Malaysia\" />\n  <meta name=\"robots\" content=\"noindex, nofollow\" />\n  <!-- laravel CRUD token -->\n  <meta name=\"csrf-token\" content=\"ygDDzYV6CBzv7iPa2URQxgnK5v6JDHsZPGxrLyll\" />\n  <!-- Canonical SEO -->\n  <link rel=\"canonical\" href=\"https://themeselection.com/item/materio-dashboard-pro-laravel/\" />\n  <!-- Favicon -->\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"https://atap.seda.gov.my/assets/img/favicon/favicon.ico\" />\n\n  <!-- Include Styles -->\n  <!-- $isFront is used to append the front layout styles only on the front layout otherwise the variable will be blank -->\n  <!-- BEGIN: Theme CSS-->\n<!-- Fonts -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&ampdisplay=swap\" rel=\"stylesheet\" />\n\n<!-- Fonts Icons -->\n<link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/iconify-CUE6U6uZ.css\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/iconify-CUE6U6uZ.css\" class=\"\" />\n<!-- BEGIN: Vendor CSS-->\n<link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/node-waves-CNx6tA5W.css\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/node-waves-CNx6tA5W.css\" class=\"\" />\n  <link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/pickr-themes-CFnMLNHJ.css\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/pickr-themes-CFnMLNHJ.css\" class=\"\" />\n<!-- Core CSS -->\n<link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/core-wxqiSdYo.css\" /><link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/demo-BxsKPLJR.css\" /><link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/perfect-scrollbar-CfyPsj0y.css\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/core-wxqiSdYo.css\" class=\"template-customizer-core-css\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/demo-BxsKPLJR.css\" class=\"\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/perfect-scrollbar-CfyPsj0y.css\" class=\"\" />\n<!-- Vendor Styles -->\n<link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/perfect-scrollbar-CfyPsj0y.css\" /><link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/typeahead-CKaqM2Dk.css\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/perfect-scrollbar-CfyPsj0y.css\" class=\"\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/typeahead-CKaqM2Dk.css\" class=\"\" />\n<!-- SweetAlert2 Styles -->\n<link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/animate-BP00llhF.css\" /><link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/sweetalert2-C6Iw9aw4.css\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/animate-BP00llhF.css\" class=\"\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/sweetalert2-C6Iw9aw4.css\" class=\"\" />\n\n<link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/flatpickr-B7pB74XQ.css\" /><link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/bootstrap-daterangepicker-DpM5rV1g.css\" /><link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/jquery-timepicker-ClC8et_v.css\" /><link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/pickr-themes-CFnMLNHJ.css\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/flatpickr-B7pB74XQ.css\" class=\"\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/bootstrap-daterangepicker-DpM5rV1g.css\" class=\"\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/jquery-timepicker-ClC8et_v.css\" class=\"\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/pickr-themes-CFnMLNHJ.css\" class=\"\" />\n\n<link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/select2-CdrSatkw.css\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/select2-CdrSatkw.css\" class=\"\" />\n\n<!-- Page Styles -->\n\n<!-- app CSS -->\n<link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/app-D2sQMZPB.css\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/app-D2sQMZPB.css\" class=\"\" /><!-- END: app CSS-->\n\n  \n  <!-- Include Scripts for customizer, helper, analytics, config -->\n  <!-- $isFront is used to append the front layout scriptsIncludes only on the front layout otherwise the variable will be blank -->\n  <!-- laravel style -->\n<link rel=\"modulepreload\" as=\"script\" href=\"https://atap.seda.gov.my/build/assets/helpers-wD9hV1oH.js\" /><script type=\"module\" src=\"https://atap.seda.gov.my/build/assets/helpers-wD9hV1oH.js\"></script><!-- beautify ignore:start -->\n<!--! Template customizer & Theme config files MUST be included after core stylesheets and helpers.js in the <head> section -->\n  <!--? Template customizer: To hide customizer set displayCustomizer value false in config.js.  -->\n  <link rel=\"preload\" as=\"style\" href=\"https://atap.seda.gov.my/build/assets/template-customizer-CyQME3xr.css\" /><link rel=\"modulepreload\" as=\"script\" href=\"https://atap.seda.gov.my/build/assets/template-customizer-Dbqkuulf.js\" /><link rel=\"stylesheet\" href=\"https://atap.seda.gov.my/build/assets/template-customizer-CyQME3xr.css\" /><script type=\"module\" src=\"https://atap.seda.gov.my/build/assets/template-customizer-Dbqkuulf.js\"></script>\n  <!--? Config:  Mandatory theme config file contain global vars & default theme options, Set your preferred theme option in this file.  -->\n  <link rel=\"modulepreload\" as=\"script\" href=\"https://atap.seda.gov.my/build/assets/config-BoP0Nie5.js\" /><script type=\"module\" src=\"https://atap.seda.gov.my/build/assets/config-BoP0Nie5.js\"></script>\n<script type=\"module\">\n  document.addEventListener('DOMContentLoaded', function() {\n    // Initialize template customizer after DOM is loaded\n    if (window.TemplateCustomizer) {\n      try {\n        // Get the skin currently applied to the document\n        const appliedSkin = document.documentElement.getAttribute('data-skin') || \"default\";\n\n        window.templateCustomizer = new TemplateCustomizer({\n          defaultTextDir: \"ltr\",\n                    defaultTheme: \"light\",\n          defaultSkin: appliedSkin,\n          defaultSemiDark: false,\n          defaultShowDropdownOnHover: \"1\",\n          displayCustomizer: \"1\",\n          lang: 'en',\n          'controls': [\"color\",\"theme\",\"skins\",\"semiDark\",\"layoutCollapsed\",\"layoutNavbarOptions\",\"headerType\",\"contentLayout\",\"rtl\"],\n        });\n\n        // Ensure color is applied on page load\n              } catch (error) {\n        console.warn('Template customizer initialization error:', error);\n      }\n    }\n  });\n</script>\n</head>\n\n<body>\n  <!-- Layout Content -->\n  \t<div class=\"layout-wrapper layout-content-navbar \">\n\t\t<div class=\"layout-container\">\n\n\t\t\t\t\t\t<aside id=\"layout-menu\" class=\"layout-menu menu-vertical menu\" >\n\n    <!-- ! Hide app brand if navbar-full -->\n            <div class=\"app-brand demo\">\n            <a href=\"https://atap.seda.gov.my\" class=\"app-brand-link gap-xl-0 gap-2\">\n                <span class=\"app-brand-logo demo me-1\"><span class=\"text-primary\">\n    \n    <img src=\"https://atap.seda.gov.my/assets/img/seda/eatap-logo.png?v=1.0.1\" alt=\"eATAP Logo\" width=\"45\" height=\"22\" />\n</span>\n</span>\n                <span class=\"demo menu-text fw-semibold ms-2 text-black\">eATAP</span>\n            </a>\n\n            <a href=\"javascript:void(0);\" class=\"layout-menu-toggle menu-link text-large ms-auto\">\n                <i class=\"menu-toggle-icon d-xl-inline-block align-middle\"></i>\n            </a>\n        </div>\n    \n    <div class=\"menu-inner-shadow\"></div>\n    <ul class=\"menu-inner py-1\">\n        \n                    \n                            \n\n                \n                                    \n                    \n                    \n                    <li class=\"menu-item \">\n                        <a href=\"https://atap.seda.gov.my/home\" class=\"menu-link\" >\n                                                            <i class=\"menu-icon icon-base ri ri-home-smile-line\"></i>\n                                                        <div>Home</div>\n                                                    </a>\n\n                        \n                                            </li>\n                                                \n                            \n\n                \n                                    <li class=\"menu-header mt-7\">\n                        <span class=\"menu-header-text\">Contractor: Menu</span>\n                    </li>\n                                                \n                            \n\n                \n                                    \n                    \n                    \n                    <li class=\"menu-item \">\n                        <a href=\"javascript:void(0);\" class=\"menu-link menu-toggle\" >\n                                                            <i class=\"menu-icon icon-base ri ri-mail-open-line\"></i>\n                                                        <div>My Account</div>\n                                                    </a>\n\n                        \n                                                    <ul class=\"menu-sub\">\n            \n      \n    \n    \n      <li class=\"menu-item \">\n        <a href=\"https://atap.seda.gov.my/my_account/profile/contractor\" class=\"menu-link\" >\n                    <div>My Profile</div>\n                  </a>\n\n        \n              </li>\n                \n      \n    \n    \n      <li class=\"menu-item \">\n        <a href=\"https://atap.seda.gov.my/my_account/change_password\" class=\"menu-link\" >\n                    <div>Change Password</div>\n                  </a>\n\n        \n              </li>\n            </ul>\n                                            </li>\n                                                \n                            \n\n                \n                                    \n                    \n                    \n                    <li class=\"menu-item active\">\n                        <a href=\"https://atap.seda.gov.my/profiles\" class=\"menu-link\" >\n                                                            <i class=\"menu-icon icon-base ri ri-mail-open-line\"></i>\n                                                        <div>Applicant Profiles</div>\n                                                    </a>\n\n                        \n                                            </li>\n                                                \n                            \n\n                \n                                    \n                    \n                    \n                    <li class=\"menu-item \">\n                        <a href=\"https://atap.seda.gov.my/applications\" class=\"menu-link\" >\n                                                            <i class=\"menu-icon icon-base ri ri-wechat-line\"></i>\n                                                        <div>Applications</div>\n                                                    </a>\n\n                        \n                                            </li>\n                                                \n                            \n\n                \n                                    \n                    \n                    \n                    <li class=\"menu-item \">\n                        <a href=\"https://atap.seda.gov.my/messages\" class=\"menu-link\" >\n                                                            <i class=\"menu-icon icon-base ri ri-drag-drop-line\"></i>\n                                                        <div>Messages</div>\n                                                    </a>\n\n                        \n                                            </li>\n                                            \n    </ul>\n\n</aside>\n\t\t\t\n\t\t\t<!-- Layout page -->\n\t\t\t<div class=\"layout-page\">\n\n\t\t\t\t\n\t\t\t\t\n\n\t\t\t\t<!-- BEGIN: Navbar-->\n\t\t\t\t\t\t\t\t\t<!-- Navbar -->\n<nav\n  class=\"layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme\"\n  id=\"layout-navbar\">\n  <!--  Brand demo (display only for navbar-full and hide on below xl) -->\n\n<!-- ! Not required for layout-without-menu -->\n    <div class=\"layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0   d-xl-none \">\n        <a class=\"nav-item nav-link px-0 me-xl-6\" href=\"javascript:void(0)\">\n            <i class=\"icon-base ri ri-menu-line icon-md\"></i>\n        </a>\n    </div>\n\n<div class=\"navbar-nav-right d-flex align-items-center justify-content-end\" id=\"navbar-collapse\">\n\n    \n    \n    <ul class=\"navbar-nav flex-row align-items-center ms-md-auto\">\n        \n                    <!-- Style Switcher -->\n            <li class=\"nav-item dropdown me-sm-2 me-xl-0\">\n                <a class=\"nav-link dropdown-toggle hide-arrow btn btn-icon btn-text-secondary rounded-pill\" id=\"nav-theme\" href=\"javascript:void(0);\" data-bs-toggle=\"dropdown\">\n                    <i class=\"icon-base ri ri-sun-line icon-22px theme-icon-active\"></i>\n                    <span class=\"d-none ms-2\" id=\"nav-theme-text\">Toggle theme</span>\n                </a>\n                <ul class=\"dropdown-menu dropdown-menu-end\" aria-labelledby=\"nav-theme-text\">\n                    <li>\n                        <button type=\"button\" class=\"dropdown-item align-items-center active\" data-bs-theme-value=\"light\" aria-pressed=\"false\">\n                            <span> <i class=\"icon-base ri ri-sun-line icon-md me-3\" data-icon=\"sun-line\"></i>Light</span>\n                        </button>\n                    </li>\n                    <li>\n                        <button type=\"button\" class=\"dropdown-item align-items-center\" data-bs-theme-value=\"dark\" aria-pressed=\"true\">\n                            <span> <i class=\"icon-base ri ri-moon-clear-line icon-md me-3\" data-icon=\"moon-clear-line\"></i>Dark</span>\n                        </button>\n                    </li>\n                    <li>\n                        <button type=\"button\" class=\"dropdown-item align-items-center\" data-bs-theme-value=\"system\" aria-pressed=\"false\">\n                            <span> <i class=\"icon-base ri ri-computer-line icon-md me-3\" data-icon=\"computer-line\"></i>System</span>\n                        </button>\n                    </li>\n                </ul>\n            </li>\n            <!-- / Style Switcher-->\n        \n        <!-- User -->\n        <li class=\"nav-item navbar-dropdown dropdown-user dropdown\">\n            <a class=\"nav-link dropdown-toggle hide-arrow p-0\" href=\"javascript:void(0);\" data-bs-toggle=\"dropdown\">\n                <div class=\"avatar avatar-online\">\n                    <img src=\"https://atap.seda.gov.my/assets/img/avatars/3.png\" alt=\"alt\" class=\"rounded-circle\" />\n                </div>\n            </a>\n            <ul class=\"dropdown-menu dropdown-menu-end mt-3 py-2\">\n                <li>\n                    <a class=\"dropdown-item\" href=\"https://atap.seda.gov.my/pages/profile-user\">\n                        <div class=\"d-flex align-items-center\">\n                            <div class=\"flex-shrink-0 me-2\">\n                                <div class=\"avatar avatar-online\">\n                                    <img src=\"https://atap.seda.gov.my/assets/img/avatars/3.png\" alt=\"alt\" class=\"w-px-40 h-auto rounded-circle\" />\n                                </div>\n                            </div>\n                            <div class=\"flex-grow-1\">\n                                <h6 class=\"mb-0 small\">\n                                                                            ETERNALGY SDN BHD\n                                                                    </h6>\n                                                            </div>\n                        </div>\n                    </a>\n                </li>\n                <li>\n                    <div class=\"dropdown-divider my-1\"></div>\n                </li>\n                                    <li>\n                        <div class=\"d-grid px-4 pt-2 pb-1\">\n                            <a class=\"btn btn-danger d-flex\" href=\"https://atap.seda.gov.my/logout\" onclick=\"event.preventDefault(); document.getElementById('logout-form').submit();\">\n                                <i class=\"icon-base ri ri-logout-box-r-line ms-2 icon-16px\"></i>\n                                <small class=\"align-middle\">Logout</small>\n                            </a>\n                        </div>\n                    </li>\n                    <form method=\"POST\" id=\"logout-form\" action=\"https://atap.seda.gov.my/logout\">\n                        <input type=\"hidden\" name=\"_token\" value=\"ygDDzYV6CBzv7iPa2URQxgnK5v6JDHsZPGxrLyll\" autocomplete=\"off\">                    </form>\n                            </ul>\n        </li>\n        <!--/ User -->\n    </ul>\n</div>\n</nav>\n<!-- / Navbar -->\n\t\t\t\t\t\t\t\t<!-- END: Navbar-->\n\n\t\t\t\t<!-- Content wrapper -->\n\t\t\t\t<div class=\"content-wrapper\">\n\n\t\t\t\t\t<!-- Content -->\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"container-xxl flex-grow-1 container-p-y\">\n\t\t\t\t\t\n\t\t\t\t\t<div class=\"alert alert-danger alert-dismissible fade show\" role=\"alert\">\n\t\t<h6 class=\"alert-heading mb-1\">\n\t\t\t<i class=\"ri ri-error-warning-line me-2\"></i>Opps!\n\t\t</h6>\n\t\t<span>Please correct the following errors:</span>\n\t\t<ul class=\"mb-0 mt-2\">\n\t\t\t\t\t\t\t<li>The Telephone No format is invalid.</li>\n\t\t\t\t\t</ul>\n\t\t<button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"alert\" aria-label=\"Close\"></button>\n\t</div>\n\n\t\t\t\t\t    <div class=\"col-md-12\">\n                    <form class=\"form-horizontal\" method=\"POST\" action=\"https://atap.seda.gov.my/profiles/individuals\"><input type=\"hidden\" name=\"_token\" value=\"ygDDzYV6CBzv7iPa2URQxgnK5v6JDHsZPGxrLyll\">\n                <div class=\"card mb-4\">\n    <div class=\"card-header d-flex justify-content-between align-items-center\">\n        <div>\n                            <h5 class=\"mb-0\">Individual Profile</h5>\n                    </div>\n        <div>\n                    </div>\n    </div>\n    <div class=\"card-body\">\n                    <div class=\"row mb-4\">\n                <div class=\"col-lg-3\">\n                    <div class=\"card bg-primary text-white\">\n                        <div class=\"card-body p-2\">\n                            <div class=\"d-flex align-items-center\">\n                                <i class=\"fa fa-group fa-2x me-2\"></i>\n                                <div>\n                                    <span>Step 1</span>\n                                    <h6 class=\"mb-0\">Individual Profile</h6>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                                    <div class=\"col-lg-3\">\n                        <div class=\"card bg-light\">\n                            <div class=\"card-body p-2\">\n                                <div class=\"d-flex align-items-center\">\n                                    <i class=\"fa fa-pencil fa-2x me-2\"></i>\n                                    <div>\n                                        <span>Step 2</span>\n                                        <h6 class=\"mb-0\">Application Details</h6>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-lg-3\">\n                        <div class=\"card bg-light\">\n                            <div class=\"card-body p-2\">\n                                <div class=\"d-flex align-items-center\">\n                                    <i class=\"fa fa-file-text-o fa-2x me-2\"></i>\n                                    <div>\n                                        <span>Step 3</span>\n                                        <h6 class=\"mb-0\">Supporting Documents</h6>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-lg-3\">\n                        <div class=\"card bg-light\">\n                            <div class=\"card-body p-2\">\n                                <div class=\"d-flex align-items-center\">\n                                    <i class=\"fa fa-rocket fa-2x me-2\"></i>\n                                    <div>\n                                        <span>Step 4</span>\n                                        <h6 class=\"mb-0\">Workplan & Declaration</h6>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                            </div>\n                <hr class=\"my-6 mx-n4\" />\n        <input type=\"hidden\" name=\"_token\" value=\"ygDDzYV6CBzv7iPa2URQxgnK5v6JDHsZPGxrLyll\" autocomplete=\"off\">                <h6 class=\"mb-4\">1. Individual Details</h6>\n        <div class=\"row mb-4\">\n            <label class=\"col-sm-3 col-form-label\" for=\"salutation\">Salutation<span class=\"text-danger\">*</span></label>\n            <div class=\"col-sm-9\">\n                <input class=\"form-control\" type=\"text\" name=\"salutation\" id=\"salutation\" value=\"MR.\" required placeholder=\"Salutation\">\n                            </div>\n        </div>\n        <div class=\"row mb-4\">\n            <label class=\"col-sm-3 col-form-label\" for=\"name\">Name<span class=\"text-danger\">*</span></label>\n            <div class=\"col-sm-9\">\n                                    <input class=\"form-control\" type=\"text\" name=\"name\" id=\"name\" value=\"GAN ZHI HONG TEST\" required placeholder=\"Name\">\n                                <span class=\"help-block\">Please insert your name as per Mykad/Passport</span>\n                            </div>\n        </div>\n        <div class=\"row mb-4\">\n            <label class=\"col-sm-3 col-form-label\" for=\"citizenship\">Citizenship<span class=\"text-danger\">*</span></label>\n            <div class=\"col-sm-9\">\n                <select class=\"form-control\" name=\"citizenship\" id=\"citizenship\" required><option value>--Select--</option><option value=\"Malaysian\" selected=\"selected\">Malaysian</option><option value=\"Afghan\">Afghan</option><option value=\"Albanian\">Albanian</option><option value=\"Algerian\">Algerian</option><option value=\"American\">American</option><option value=\"Andorran\">Andorran</option><option value=\"Angolan\">Angolan</option><option value=\"Antiguans\">Antiguans</option><option value=\"Argentinean\">Argentinean</option><option value=\"Armenian\">Armenian</option><option value=\"Australian\">Australian</option><option value=\"Austrian\">Austrian</option><option value=\"Azerbaijani\">Azerbaijani</option><option value=\"Bahamian\">Bahamian</option><option value=\"Bahraini\">Bahraini</option><option value=\"Bangladeshi\">Bangladeshi</option><option value=\"Bar