>Relationship<span class=\"text-danger\">*</span></label>\n            <div class=\"col-sm-9\">\n                <input class=\"form-control\" type=\"text\" name=\"contact_relationship\" id=\"contact_relationship\" value=\"WIFE\" required placeholder=\"Relationship\">\n                            </div>\n        </div>\n        <div class=\"row mb-4\">\n            <label class=\"col-sm-3 col-form-label\" for=\"contact_email\">Email<span class=\"text-danger\">*</span></label>\n            <div class=\"col-sm-9\">\n                <input class=\"form-control\" type=\"email\" name=\"contact_email\" id=\"contact_email\" value=\"zhihong0321@gmail.com\" required placeholder=\"Email\" oninput=\"validateContactEmail(this)\">\n                <span id=\"contact-email-error\" class=\"text-danger d-block\" style=\"display:none;\"></span>\n                            </div>\n        </div>\n        <script>\n            function validateContactEmail(input) {\n                const value = input.value.trim();\n                const errorSpan = document.getElementById('contact-email-error');\n                let error = '';\n                if (value.length > 0 && !/^([a-zA-Z0-9_\\-.+]+)@([a-zA-Z0-9\\-.]+)\\.([a-zA-Z]{2,})$/.test(value)) {\n                    error = 'Please enter a valid email address.';\n                }\n                if (error) {\n                    errorSpan.textContent = error;\n                    errorSpan.style.display = 'block';\n                    input.classList.add('is-invalid');\n                } else {\n                    errorSpan.textContent = '';\n                    errorSpan.style.display = 'none';\n                    input.classList.remove('is-invalid');\n                }\n            }\n        </script>\n        <div class=\"row mb-4\">\n            <label class=\"col-sm-3 col-form-label\" for=\"contact_phone\">Telephone No</label>\n            <div class=\"col-sm-9\">\n                <input class=\"form-control is-invalid\" type=\"text\" name=\"contact_phone\" id=\"contact_phone\" value=\"01121000099\" placeholder=\"e.g., 0312345678\" inputmode=\"numeric\" pattern=\"[0-9]*\">\n                <div class=\"form-text text-muted mt-1\">\n                    <small>Enter full phone number including area code (e.g., 0312345678)</small>\n                </div>\n                                    <span class=\"text-danger\">The Telephone No format is invalid.</span>\n                            </div>\n        </div>\n        <div class=\"row mb-4\">\n            <label class=\"col-sm-3 col-form-label\" for=\"contact_mobile\">Mobile No<span class=\"text-danger\">*</span></label>\n            <div class=\"col-sm-9\">\n                <input class=\"form-control\" type=\"text\" name=\"contact_mobile\" id=\"contact_mobile\" value=\"0126039205\" required placeholder=\"e.g., 0123456789\" inputmode=\"numeric\" pattern=\"[0-9]*\">\n                <div class=\"form-text text-muted mt-1\">\n                    <small>Enter full mobile number (e.g., 0123456789)</small>\n                </div>\n                            </div>\n        </div>\n        <div class=\"pt-4\">\n            <div class=\"row justify-content-end\">\n                <div class=\"col-sm-9 text-end\">\n                    <button type=\"submit\" class=\"btn btn-primary me-4\">\n                        <i class=\"fa fa-save me-2\"></i>Submit\n                    </button>\n                    <button type=\"reset\" class=\"btn btn-outline-secondary\">Cancel</button>\n                </div>\n            </div>\n        </div>\n        <div class=\"clearfix\"></div>\n    </div>\n</div>\n        </form>\n    </div>\n\n\t\t\t\t</div>\n\t\t\t\t<!-- / Content -->\n\n\t\t\t\t<!-- Footer -->\n\t\t\t\t\t\t\t\t\t<!-- Footer -->\n<footer class=\"content-footer footer bg-footer-theme position-fixed bottom-0 end-0 shadow-lg rounded-start-3\" style=\"width: auto; z-index: 1000; backdrop-filter: blur(10px); background-color: rgba(255, 255, 255, 