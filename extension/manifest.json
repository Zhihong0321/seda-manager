{
    "manifest_version": 3,
    "name": "SEDA Application Mapper",
    "version": "1.1.0",
    "description": "Fills SEDA application forms using data from your local system.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "cookies"
    ],
    "host_permissions": [
        "*://*.seda.gov.my/*",
        "https://seda-manager-production.up.railway.app/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://atap.seda.gov.my/applications/*",
                "https://atap.seda.gov.my/profiles*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}